<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>InSilico</groupId>
    <artifactId>Vega-GUI</artifactId>
    <version>1.2.9-b2</version>

    <name>Vega - GUI</name>
    <description>
        VEGA GUI for Insilico project - CDK 2.3, Java 17
    </description>


    <properties>
        <java.version>17</java.version>
        <skipTests>true</skipTests>
        <vega.core.version>1.3.25</vega.core.version>
        <!-- Core 1.3.25 needs VegaResources-Cddd 1.1.1 or later (app-cddd.py reading the model next to it) -->
        <vega.resources.cddd.version>1.1.1</vega.resources.cddd.version>
        <maven.build.timestamp.format>dd/MM/yyyy</maven.build.timestamp.format>
        <!-- maven.build.timestamp cannot be filtered directly inside resources -->
        <vega.build.date>${maven.build.timestamp}</vega.build.date>
    </properties>

    <!-- No distributionManagement: the GUI is not published as a Maven artifact, its jar is distributed directly -->

    <repositories>
        <repository>
            <id>maven-central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <!-- public repo hosted by ProtoQSAR, access with maven-public:maven-public -->
            <id>protoqsar-maven-public</id>
            <url>https://nexus.protoqsar.com/repository/maven-public/</url>
        </repository>

        <repository>
            <id>bubuntux-repo</id>
            <url>https://raw.github.com/bubuntux/mvn/repo/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>2.26.1</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <!-- The GUI is the final assembly: the Core version is fixed here, whatever the model modules declare -->
            <dependency>
                <groupId>InSilico</groupId>
                <artifactId>Core</artifactId>
                <version>${vega.core.version}</version>
            </dependency>
            <!-- Fixed together with the Core, which requires at least this version -->
            <dependency>
                <groupId>InSilico</groupId>
                <artifactId>VegaResources-Cddd</artifactId>
                <version>${vega.resources.cddd.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.netbeans</groupId>
            <artifactId>awtextra</artifactId>
            <version>0.0.1</version>
        </dependency>

        <dependency>
            <groupId>InSilico</groupId>
            <artifactId>VegaModels-All</artifactId>
            <version>1.3.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <profiles>
        <profile>
            <id>with-condapack</id>
            <dependencies>
                <dependency>
                    <groupId>InSilico</groupId>
                    <artifactId>VegaPythonEnv-Global</artifactId>
                    <version>1.0.0</version>
                </dependency>
                <dependency>
                    <groupId>InSilico</groupId>
                    <artifactId>VegaPythonEnv-Cddd</artifactId>
                    <version>1.0.0</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources/form</directory>
                <targetPath>../classes/form</targetPath>
            </resource>
            <resource>
                <directory>src/main/resources/icons</directory>
                <targetPath>../classes/icons</targetPath>
            </resource>
            <resource>
                <directory>src/main/resources/resources</directory>
                <targetPath>../classes/resources</targetPath>
            </resource>
            <resource>
                <directory>src/main/resources/condapack-env</directory>
                <targetPath>../condapack-env</targetPath>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
                <excludes>
                    <exclude>vega-build.properties</exclude>
                </excludes>
            </resource>
            <!-- Only this file is filtered: icons, PDFs and zips must be copied untouched -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>vega-build.properties</include>
                </includes>
            </resource>
        </resources>


        <plugins>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>insilico.vega.launcher.Launcher</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Fails the build when a dependency is silently downgraded below what some path requires: an old Core
                 winning by distance would otherwise show up only at runtime, on the user's computer -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-upper-bound-deps</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireUpperBoundDeps>
                                    <excludes>
                                        <!-- The Core declares 3.6 while poi asks for 3.6.1: kept as the Core
                                             resolves it, so that the GUI computes with the same library as the
                                             model regression tests -->
                                        <exclude>org.apache.commons:commons-math3</exclude>
                                    </excludes>
                                </requireUpperBoundDeps>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                    </execution>
<!--                    <execution>-->
<!--                        <id>unpack</id>-->
<!--                        <phase>package</phase>-->
<!--                        <goals>-->
<!--                            <goal>unpack</goal>-->
<!--                        </goals>-->
<!--                        <configuration>-->
<!--                            <artifactItems>-->
<!--                                <artifactItem>-->
<!--                                    <groupId>${project.groupId}</groupId>-->
<!--                                    <artifactId>${project.artifactId}</artifactId>-->
<!--                                    <version>${project.version}</version>-->
<!--                                </artifactItem>-->
<!--                            </artifactItems>-->
<!--                        </configuration>-->
<!--                    </execution>-->
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- the GUI is not deployed: no reduced pom to write in the project folder -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>insilico.vega.launcher.SuperLauncher</mainClass>
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>

                            <filters>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>